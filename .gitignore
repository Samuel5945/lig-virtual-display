# ---- runtime state (regenerated by the daemon / panel) ----
stop.flag
realonly.flag
pid.txt
guardian_pid.txt
guardian_heartbeat.txt
gui_settings.json
gui_selftest.txt

# ---- logs ----
*.log
*.log.old
*.err

# ---- python ----
__pycache__/
*.py[cod]

# ---- pyinstaller ----
build/
dist/
*.pkg

# ---- archived old implementation ----
# 49 files including two 11 MB panel exes (~59 MB total).
# Kept on disk for reference, deliberately out of version history.
_archive_old_ParsecVDD/
_staging/

# ---- never commit a 49 MB bundle ----
*.exe

# ---- editor / os ----
.vscode/
.idea/
Thumbs.db
desktop.ini

# ---- misc backups ----
*.bak
*.bak-*
*.old
*~

# ---- scratch diagnostics (engine/panel write these while investigating) ----
_diag_*.txt
_diag_*.log
_*.txt

# ---- vendored third-party driver binaries ----
# MttVDD is a third-party signed driver. The binaries (dll/cat/devcon) are
# deliberately NOT committed - fetch them from the release page instead:
#   https://github.com/VirtualDrivers/Virtual-Display-Driver/releases/tag/25.7.23
#   -> VirtualDisplayDriver-x86.Driver.Only.zip  and  VDD.Control.25.7.23.zip
# Only the INF (documentation) and our config XML are tracked.
driver/*.exe
driver/*.dll
driver/*.cat
driver/*.sys
driver/*.zip
