# Windows-only project: keep CRLF in the working tree, LF in the index.
# Being explicit avoids "LF will be replaced by CRLF" churn later.
*.py    text eol=crlf
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.md    text eol=crlf
*.json  text eol=crlf
*.spec  text eol=crlf
.gitignore   text eol=crlf
.gitattributes text eol=crlf

# binaries - never diff or convert these
*.ico   binary
*.png   binary
*.jpg   binary
*.exe   binary
*.dll   binary
